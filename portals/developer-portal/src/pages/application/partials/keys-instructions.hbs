{{#each keyManagersMetadata}}
{{#if enabled}}
{{#each applicationKeys}}
<div class="modal dp-ui__modal" id='keysInstructionsModal-{{keyType}}'>
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content dp-ui__modal-content">
            <div class="dp-ui__modal-header">
                <h2 class="dp-ui__modal-title m-0">Instructions to Generate Access Token ({{keyType}})</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                    onclick="closeModal('keysInstructionsModal-{{keyType}}')"></button>
            </div>
            <div class="dp-ui__modal-body">
                <div class="container">
                    <div id="tokenGenerationButtons_{{../id}}_{{keyType}}" class="mb-4">
                        <div class="row">
                            <div id="requestDetails_{{../id}}_{{keyType}}" class="mb-3">
                                <p class="small dp-keys__instruction-text">You can use the following details to generate an access token using the client credentials grant type:</p>
                                <div class="dp-token__details-card">
                                    <div class="dp-token__details-content">
                                        <div class="dp-detail__item">
                                            <span class="dp-detail__label">Token Endpoint URL:</span>
                                            <span class="dp-detail__value">{{../tokenEndpoint}}</span>
                                        </div>
                                        <div class="dp-detail__item">
                                            <span class="dp-detail__label">Authorization:</span>
                                            <span class="dp-detail__value">Basic Base64(consumer_key:consumer_secret)</span>
                                        </div>
                                        <div class="dp-detail__item">
                                            <span class="dp-detail__label">Content Type:</span>
                                            <span class="dp-detail__value">application/x-www-form-urlencoded</span>
                                        </div>
                                        <div class="dp-detail__item">
                                            <span class="dp-detail__label">Payload:</span>
                                            <span class="dp-detail__value">grant_type=client_credentials</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div id="curlDisplay_{{../id}}_{{keyType}}">
                                <p class="small mb-2 dp-keys__instruction-header">cURL to Generate Access Token</p>
                                <p class="dp-keys__curl-description">
                                    The following cURL command template allows you to generate an access token using the
                                    client credentials grant type. Click the copy button to copy the command with your
                                    actual credentials inserted.
                                </p>
                                <div class="dp-keys__oauth2-code-block">
                                    <button class="dp-copy__button dp-copy__btn" id="curl-copy-{{../id}}-{{keyType}}"
                                        data-endpoint="{{../tokenEndpoint}}" aria-label="Copy to clipboard with real values" onclick="copyRealCurl(this)">
                                        <span class="dp-copy__btn-icon"><i class="bi bi-copy"></i></span>
                                        <span class="dp-copy__btn-check"><i class="bi bi-check"></i> Copied</span>
                                    </button>
                                    <code
                                        id="curl_{{../id}}_{{keyType}}">curl -k -X POST &lt;TOKEN_ENDPOINT_URL&gt; -d "grant_type=client_credentials" -H "Authorization: Basic Base64(&lt;CONSUMER_KEY&gt;:&lt;CONSUMER_SECRET&gt;)"</code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/each}}
{{/if}}
{{/each}}
