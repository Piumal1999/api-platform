<div class="dp-keys__km-card {{#if isSandbox}}dp-keys__km-card--sandbox{{/if}}">

    {{!-- Card header --}}
    <div class="dp-keys__km-header">
        <div class="dp-keys__km-icon {{#if isSandbox}}dp-keys__km-icon--sandbox{{/if}}">
            <i class="bi bi-key-fill"></i>
        </div>
        <div class="dp-keys__km-info">
            <span class="dp-keys__km-name">{{kmName}}</span>
        </div>
        <span class="dp-keys__km-badge {{#if isSandbox}}dp-keys__km-badge--sandbox{{/if}}">
            <span class="dp-keys__km-badge-dot"></span> Active
        </span>
    </div>

    {{!-- Inner tab nav — only visible when credentials exist --}}
    <div class="dp-keys__km-tabnav" id="keyTabNav-{{keyType}}" role="tablist"
        style="{{#unless keys.consumerKey}}display:none{{/unless}}">
        <button class="dp-keys__km-tab active" type="button" role="tab"
            id="tab-btn-creds-{{kmId}}-{{keyType}}"
            data-bs-toggle="tab" data-bs-target="#tab-creds-{{kmId}}-{{keyType}}"
            aria-controls="tab-creds-{{kmId}}-{{keyType}}" aria-selected="true">
            <i class="bi bi-key"></i> Credentials
        </button>
        <button class="dp-keys__km-tab" type="button" role="tab"
            id="tab-btn-token-{{kmId}}-{{keyType}}"
            data-bs-toggle="tab" data-bs-target="#tab-token-{{kmId}}-{{keyType}}"
            aria-controls="tab-token-{{kmId}}-{{keyType}}" aria-selected="false">
            <i class="bi bi-lightning-fill"></i> Generate Token
        </button>
        <button class="dp-keys__km-tab" type="button" role="tab"
            id="tab-btn-curl-{{kmId}}-{{keyType}}"
            data-bs-toggle="tab" data-bs-target="#tab-curl-{{kmId}}-{{keyType}}"
            aria-controls="tab-curl-{{kmId}}-{{keyType}}" aria-selected="false">
            <i class="bi bi-terminal"></i> cURL
        </button>
    </div>

    {{!-- Tab content — only rendered when credentials exist --}}
    <div class="tab-content dp-keys__km-tab-content" id="consumerKeyContainer-{{keyType}}"
        style="{{#unless keys.consumerKey}}display:none{{/unless}}">

        {{!-- ── Credentials tab ── --}}
        <div class="tab-pane fade show active" id="tab-creds-{{kmId}}-{{keyType}}"
            role="tabpanel" aria-labelledby="tab-btn-creds-{{kmId}}-{{keyType}}" tabindex="0">
            <div class="dp-keys__km-body">
                <div class="dp-keys__cred-grid dp-keys__cred-grid--single">
                    <div class="dp-keys__field" id="consumerKey-{{keyType}}-view">
                        <label class="dp-keys__field-label">Consumer Key (Client ID)</label>
                        <div class="dp-keys__input-row">
                            <input type="text" id="consumer-key-{{kmId}}-{{keyType}}-view"
                                class="dp-keys__input" name="consumerKey-{{keyType}}"
                                value="{{keys.consumerKey}}" readonly disabled />
                            <button class="dp-keys__icon-btn dp-copy__btn"
                                onclick="copyConsumerKey('consumer-key-{{kmId}}-{{keyType}}-view')" title="Copy">
                                <span class="dp-copy__btn-icon"><i class="bi bi-copy"></i></span>
                                <span class="dp-copy__btn-check"><i class="bi bi-check"></i> Copied</span>
                            </button>
                        </div>
                        <input type="hidden" id="app-ref-{{kmId}}-{{keyType}}" name="appRefId" value="{{keys.appRefId}}" />
                        <input type="hidden" id="key-map-{{kmId}}-{{keyType}}" name="keyMappingId" value="{{keys.keyMappingId}}" />
                    </div>
                </div>
            </div>
            {{!-- Revoke footer — part of Credentials tab --}}
            <div class="dp-keys__km-footer" id="keyActionsContainer-{{keyType}}">
                <span class="dp-keys__secret-note">
                    <i class="bi bi-info-circle"></i>
                    Revoking removes all credentials. Tokens already issued remain valid until they expire.
                </span>
                <div class="dp-keys__footer-actions">
                    <button class="dp-keys__btn--danger {{#if isReadOnlyMode}}disabled{{/if}}"
                        style="{{#if isReadOnlyMode}}pointer-events:none;opacity:.5{{/if}}"
                        onclick="confirmAndRevokeKeys('{{appId}}', '{{keys.keyMappingId}}', '{{keyType}}')">
                        <i class="bi bi-trash3"></i> Revoke keys
                    </button>
                </div>
            </div>
        </div>

        {{!-- ── Generate Token tab ── --}}
        <div class="tab-pane fade" id="tab-token-{{kmId}}-{{keyType}}"
            role="tabpanel" aria-labelledby="tab-btn-token-{{kmId}}-{{keyType}}" tabindex="0">
            <div class="dp-keys__token-form dp-keys__km-body">
                <div class="dp-keys__field dp-keys__field--wide">
                    <label class="dp-keys__field-label">Request Permissions (Scopes)</label>
                    <div class="dp-keys__input-scopes dp-keys__scope-input"
                        id="scopeContainer-{{appId}}-{{keyType}}"
                        data-scopes="{{json subscriptionScopes}}">
                        <input type="text" class="text-input"
                            id="scope-{{appId}}-{{keyType}}"
                            placeholder="Type scope and press Enter…">
                    </div>
                </div>
                <form id="inlineTokenForm-{{kmId}}-{{keyType}}" style="display:none"></form>
                <div class="dp-keys__token-actions">
                    <button id="tokenKeyBtn-{{keyType}}"
                        class="dp-keys__btn--primary {{#if isReadOnlyMode}}disabled{{/if}}"
                        data-app-id="{{appId}}"
                        data-keymappingid="{{keys.keyMappingId}}"
                        style="{{#if isReadOnlyMode}}pointer-events:none;opacity:.5{{/if}}"
                        onclick="openGenerateTokenModal('inlineTokenForm-{{kmId}}-{{keyType}}', '{{appId}}', '{{keys.keyMappingId}}', '{{kmName}}', '{{appName}}', '{{json subscriptionScopes}}', '{{keyType}}')">
                        <span class="button-normal-state"><i class="bi bi-lightning-fill"></i> Generate access token</span>
                        <span class="dp-app__button-loading" style="display:none">
                            <span class="spinner-border spinner-border-sm" role="status"></span> Generating…
                        </span>
                    </button>
                    <span class="dp-keys__token-note">Uses the consumer key &amp; secret of this key set.</span>
                </div>
            </div>
        </div>

        {{!-- ── cURL tab ── --}}
        <div class="tab-pane fade" id="tab-curl-{{kmId}}-{{keyType}}"
            role="tabpanel" aria-labelledby="tab-btn-curl-{{kmId}}-{{keyType}}" tabindex="0">
            <div class="dp-keys__curl-body dp-keys__km-body">
                <p class="dp-keys__curl-desc">Use the following cURL command to generate an access token with the client credentials grant type.</p>
                <div class="dp-keys__curl-details">
                    <div class="dp-keys__curl-row">
                        <span class="dp-keys__curl-label">Token Endpoint</span>
                        <code class="dp-keys__curl-value">{{tokenEndpoint}}</code>
                    </div>
                    <div class="dp-keys__curl-row">
                        <span class="dp-keys__curl-label">Authorization</span>
                        <code class="dp-keys__curl-value">Basic Base64(consumer_key:consumer_secret)</code>
                    </div>
                    <div class="dp-keys__curl-row">
                        <span class="dp-keys__curl-label">Content-Type</span>
                        <code class="dp-keys__curl-value">application/x-www-form-urlencoded</code>
                    </div>
                    <div class="dp-keys__curl-row">
                        <span class="dp-keys__curl-label">Payload</span>
                        <code class="dp-keys__curl-value">grant_type=client_credentials</code>
                    </div>
                </div>
                <div class="dp-keys__code-block">
                    <button class="dp-keys__curl-copy-btn dp-copy__btn"
                        data-endpoint="{{tokenEndpoint}}"
                        aria-label="Copy cURL command"
                        onclick="copyRealCurl(this)">
                        <span class="dp-copy__btn-icon"><i class="bi bi-copy"></i></span>
                        <span class="dp-copy__btn-check"><i class="bi bi-check"></i> Copied</span>
                    </button>
                    <code id="curl_{{kmName}}_{{keyType}}">curl -k -X POST &lt;TOKEN_ENDPOINT_URL&gt; -d "grant_type=client_credentials" -H "Authorization: Basic Base64(&lt;CONSUMER_KEY&gt;:&lt;CONSUMER_SECRET&gt;)"</code>
                </div>
            </div>
        </div>

    </div>{{!-- /tab-content --}}

    <div id="keyGenerationErrorContainer-{{keyType}}" class="dp-keys__error" style="display:none"></div>

    {{!-- Empty state — paste an externally-created client_id --}}
    <div class="dp-keys__km-empty" id="generateKeyContainer-{{keyType}}"
        style="{{#if keys.consumerKey}}display:none{{/if}}">
        <div class="dp-keys__empty-icon-wrap {{#if isSandbox}}dp-keys__empty-icon--sandbox{{/if}}">
            <i class="bi bi-key"></i>
        </div>
        <p class="dp-keys__empty-title">No client ID linked yet</p>
        <p class="dp-keys__empty-desc">
            Create an OAuth application directly in <strong>{{kmName}}</strong>, then paste its client ID below to
            link it to this application.
        </p>
        <div id="addClientIdError-{{kmId}}-{{keyType}}" class="dp-keys__error" style="display:none"></div>
        <div class="dp-keys__add-clientid-row">
            <input type="text" class="dp-keys__input" id="addClientIdInput-{{kmId}}-{{keyType}}"
                placeholder="Paste client ID" {{#if isReadOnlyMode}}disabled{{/if}} />
            <button data-cyid="addClientId-{{keyType}}" id="addClientIdBtn-{{kmId}}-{{keyType}}"
                class="dp-keys__btn--primary {{#if isSandbox}}dp-keys__btn--sandbox{{/if}} {{#if isReadOnlyMode}}disabled{{/if}}"
                style="{{#if isReadOnlyMode}}pointer-events:none;opacity:.5{{/if}}"
                {{#if isReadOnlyMode}}disabled{{/if}}
                onclick="addClientId('{{kmId}}', '{{keyType}}', '{{appId}}', '{{orgId}}', '{{kmName}}')">
                <span class="button-normal-state"><i class="bi bi-plus-lg me-1"></i>Add</span>
                <span class="dp-app__button-loading" style="display:none">
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>Adding…
                </span>
            </button>
        </div>
    </div>
</div>
