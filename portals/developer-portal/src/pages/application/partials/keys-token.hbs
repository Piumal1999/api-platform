{{#each keyManagersMetadata}}
{{#if enabled}}
{{#each applicationKeys}}
<div class="modal dp-ui__modal" id='keysTokenModal-{{keyType}}'>
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content dp-ui__modal-content">
            <div class="dp-ui__modal-header">
                <h2 class="dp-ui__modal-title m-0">Access Token ({{keyType}})</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-cyid="keysTokenModal-{{keyType}}-close"
                    aria-label="Close" onclick="closeModal('keysTokenModal-{{keyType}}')"></button>
            </div>
            <div class="dp-ui__modal-body">
                <div class="container">
                    <div id="regenerateKeyBtn-{{keyType}}" class="d-flex">
                        <div class="row">
                            <div id="tokenDisplay_{{../id}}_{{keyType}}" style="display: none;">
                                <div class="dp-info__title pb-2">Request Permissions (Scopes)</div>
                                <div class="dp-keys__input-scopes" id="scopeContainer-{{@root.applicationMetadata.id}}-{{keyType}}"
                                    data-scopes="{{json @root.subscriptionScopes}}">
                                    <input type="text" class="text-input" id="scope-{{@root.applicationMetadata.id}}-{{keyType}}"
                                        placeholder="Type scope and press Enter...">
                                </div>
                                <div class="alert alert-warning d-flex align-items-center mt-4" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <div>
                                        <strong>Important:</strong> This access token is displayed only once and cannot be retrieved later. Please copy and store it securely before closing this dialog.
                                    </div>
                                </div>
                                <div class="dp-token__card">
                                    <pre id="token_{{../id}}_{{keyType}}" class="dp-token__text"></pre>
                                    <button id="copyButton_{{../id}}_{{keyType}}" class="dp-copy__button" aria-label="Copy token"
                                        type="button" onclick="copyToken('{{../id}}_{{keyType}}')">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                                <div class="dp-info__title pt-2 pb-2" id="resScopeTitle-{{keyType}}">Response Permissions (Scopes)
                                </div>
                                <div id="responseScopeContainer-{{@root.applicationMetadata.id}}-{{keyType}}"
                                    data-response-scopes="">
                                </div>
                                <div class="d-flex justify-content-end mt-4 mb-3"
                                    id="applicationKeyUpdateButtonContainer-{{keyType}}">
                                    <button class="dp-common__btn-outlined pr-3 me-3" type="button"
                                        onClick="closeModal('keysTokenModal-{{keyType}}')">
                                        Cancel
                                    </button>
                                    <button
                                        class="dp-common__btn-primary btn-sm me-1 {{#if @root.isReadOnlyMode}}disabled{{/if}}"
                                        id="regenerateButton_{{../id}}_{{keyType}}"
                                        style="{{#if @root.isReadOnlyMode}}pointer-events: none; opacity: 0.5;{{/if}}"
                                        onclick="openGenerateTokenModal('applicationKeyGenerateForm-{{../id}}-{{keyType}}', '{{@root.applicationMetadata.id}}', '{{keys.keyMappingId}}', '{{../id}}', '{{@root.applicationMetadata.displayName}}', '{{json @root.subscriptionScopes}}', '{{keyType}}')">
                                        <span class="button-normal-state">
                                            <i class="bi bi-arrow-clockwise"></i> Regenerate
                                        </span>
                                        <span class="dp-app__button-loading" style="display: none;">
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            Regenerating...
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{/each}}
{{/if}}
{{/each}}
