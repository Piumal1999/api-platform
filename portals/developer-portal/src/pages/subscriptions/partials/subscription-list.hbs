{{#if subscriptions.length}}
<div class="dp-subscription__scroll table-responsive">
  <div class="dp-subscription__tablewrap">
    <script>
      window.__subscriptionOrgId = "{{@root.orgId}}";
    </script>
    <table class="dp-subscription__table" id="subscriptions-table">
      <thead>
        <tr>
          <th>API</th>
          <th>Version</th>
          <th>Type</th>
          <th>Plan</th>
          <th>Application</th>
          <th>Status</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each subscriptions}}
        <tr id="sub-row-{{this.id}}"
            data-sub-id="{{this.id}}"
            data-api-name="{{this.apiName}}"
            data-plan-name="{{this.planName}}"
            data-status="{{this.status}}">
          <td>
            <a class="dp-subscription__api-link" href="{{../baseUrl}}/api/{{this.apiHandle}}">{{this.apiName}}</a>
          </td>
          <td>{{this.apiVersion}}</td>
          <td>
            <span class="dp-subscription__type-pill">Token-based</span>
          </td>
          <td>{{this.planName}}</td>
          <td style="color:#8a98a6;">{{#if this.applicationName}}{{this.applicationName}}{{else}}-{{/if}}</td>
          <td>
            <span class="dp-subscription__status-pill {{#if (eq this.status 'ACTIVE')}}dp-subscription__status-pill--active{{else}}dp-subscription__status-pill--inactive{{/if}}">
              <span class="dp-subscription__status-dot"></span>
              {{this.status}}
            </span>
          </td>
          <td>
            <div class="dp-subscription__actions">
              <button class="dp-subscription__action-btn dp-subscription__action-btn--manage {{#if @root.isReadOnlyMode}}disabled{{/if}}"
                title="Manage subscription"
                {{#unless @root.isReadOnlyMode}}onclick="openSubManage('{{this.id}}')"{{/unless}}
                {{#if @root.isReadOnlyMode}}disabled{{/if}}>
                <i class="bi bi-sliders"></i>
              </button>
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{else}}
<div class="dp-empty" id="no-subscriptions">
  <span class="dp-empty-icon">
    <i class="bi bi-inbox"></i>
  </span>
  <h2 class="dp-empty-title">No subscriptions yet</h2>
  <p class="dp-empty-desc">Subscribe an application to an API or MCP server to start making calls. Your active subscriptions will show up here.</p>
</div>
{{/if}}

{{#unless @root.isReadOnlyMode}}
<!-- Manage subscription modal -->
<div id="subManageModal" class="dp-mcp__overlay" style="display:none;" role="dialog" aria-modal="true">
  <div class="dp-mcp__manage-modal">
    <div class="dp-mcp__manage-header">
      <div class="dp-mcp__manage-header-info">
        <span class="dp-mcp__manage-plan-icon"><i class="bi bi-lightning-charge-fill"></i></span>
        <div>
          <h2 id="subManageApiName" class="dp-mcp__manage-plan-name"></h2>
          <div class="dp-mcp__manage-subtitle"><span id="subManagePlanName"></span> · API subscription</div>
        </div>
      </div>
      <button id="subManageClose" class="dp-mcp__modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="dp-mcp__manage-body">
      <div class="dp-mcp__manage-status-row">
        <span class="dp-mcp__manage-status-label">Status</span>
        <span id="subManageStatusBadge" class="dp-mcp__manage-status-badge dp-mcp__manage-status-badge--active">Active</span>
      </div>
      <div class="dp-mcp__token-label" style="margin-top:1.25rem;">
        <i class="bi bi-key" style="color:#637282;"></i>
        <span>Subscription token</span>
      </div>
      <div class="dp-mcp__token-field dp-mcp__token-field--manage">
        <div id="subManageTokenVal" class="dp-mcp__token-val dp-mcp__token-val--manage"></div>
        <div class="dp-mcp__token-field-actions">
          <button id="subManageRevealBtn" class="dp-mcp__token-action-btn" title="Reveal token">
            <i id="subManageRevealIcon" class="bi bi-eye"></i>
          </button>
          <button id="subManageCopyBtn" class="dp-copy__btn dp-mcp__token-copy-btn" title="Copy token">
            <span class="dp-copy__btn-icon"><i class="bi bi-copy"></i></span>
            <span class="dp-copy__btn-check"><i class="bi bi-check"></i> Copied</span>
          </button>
        </div>
      </div>
      <p class="dp-mcp__config-note" style="margin:0.625rem 0 0;">Use this token as the <code class="dp-mcp__inline-code">Subscription-Key</code> header when calling this API.</p>
      <hr class="dp-mcp__manage-divider">
      <div class="dp-mcp__manage-actions">
        <button id="subManageRegenerateBtn" class="dp-btn dp-mcp__manage-action-btn dp-mcp__manage-action-btn--regenerate">
          <i class="bi bi-arrow-clockwise"></i> Regenerate
        </button>
        <button id="subManageSuspendBtn" class="dp-btn dp-mcp__manage-action-btn dp-mcp__manage-action-btn--suspend">
          <i class="bi bi-pause-circle"></i>
          <span class="dp-subscription__suspend-label">Suspend</span>
        </button>
        <button id="subManageUnsubBtn" class="dp-btn dp-mcp__manage-action-btn dp-mcp__manage-action-btn--unsub">
          <i class="bi bi-trash"></i> Unsubscribe
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Unsubscribe confirmation dialog -->
<div id="subUnsubDialog" class="dp-mcp__overlay" style="display:none;" role="dialog" aria-modal="true">
  <div class="dp-mcp__unsub-dialog">
    <div class="dp-mcp__unsub-header">
      <span class="dp-mcp__unsub-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
      <h2 id="subUnsubTitle" class="dp-mcp__unsub-title">Unsubscribe?</h2>
    </div>
    <p id="subUnsubDesc" class="dp-mcp__unsub-desc">Your applications will lose access to this API and any tokens will stop working. You can re-subscribe at any time.</p>
    <div class="dp-mcp__unsub-actions">
      <button id="subUnsubCancelBtn" class="dp-btn dp-btn--outline">Cancel</button>
      <button id="subUnsubConfirmBtn" class="dp-btn dp-mcp__unsub-confirm-btn">Unsubscribe</button>
    </div>
  </div>
</div>

<!-- Regenerate token confirmation dialog -->
<div id="subRegenerateDialog" class="dp-mcp__overlay" style="display:none;" role="dialog" aria-modal="true">
  <div class="dp-mcp__unsub-dialog">
    <div class="dp-mcp__unsub-header">
      <span class="dp-mcp__unsub-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
      <h2 class="dp-mcp__unsub-title">Regenerate token?</h2>
    </div>
    <p class="dp-mcp__unsub-desc">Your current token will be invalidated immediately. Any applications using it will need to be updated with the new token.</p>
    <div class="dp-mcp__unsub-actions">
      <button id="subRegenerateCancelBtn" class="dp-btn dp-btn--outline">Cancel</button>
      <button id="subRegenerateConfirmBtn" class="dp-btn dp-mcp__unsub-confirm-btn">Regenerate</button>
    </div>
  </div>
</div>
{{/unless}}
