      <!-- ══ Manage Labels ══ -->
      <div class="dp-settings__panel" id="dp-settings__labels">
        <div class="dp-settings__panel-header">
          <div>
            <h2 class="dp-settings__panel-title">Labels</h2>
            <p class="dp-settings__panel-desc">Labels group APIs; views make labelled APIs visible to consumers.</p>
          </div>
          <button class="dp-settings__btn-primary" id="dp-settings__add-label-btn" type="button">
            <i class="bi bi-plus"></i> Add label
          </button>
        </div>

        <div class="dp-settings__table-wrap">
          <table class="dp-settings__table">
            <thead>
              <tr>
                <th>Display name</th>
                <th>Name</th>
                <th style="width:90px;"></th>
              </tr>
            </thead>
            <tbody id="dp-settings__labels-tbody">
              {{#orgLabels}}
              <tr id="dp-settings__label-row-{{id}}" data-id="{{id}}">
                <td>
                  <button type="button" class="dp-settings__label-edit-btn" data-name="{{id}}" data-display="{{displayName}}"
                    style="border:none;background:none;padding:0;cursor:pointer;font-size:.875rem;font-weight:600;color:#1a2433;text-decoration:none;">{{displayName}}</button>
                </td>
                <td><span class="dp-settings__name-chip">{{id}}</span></td>
                <td>
                  <div class="dp-settings__row-actions">
                    <button class="dp-settings__icon-btn dp-settings__label-edit-btn" type="button" data-name="{{id}}" data-display="{{displayName}}" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button class="dp-settings__icon-btn dp-settings__icon-btn--danger dp-settings__label-delete-btn" type="button"
                      data-name="{{id}}" data-display="{{displayName}}" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
              {{/orgLabels}}
              {{#unless orgLabels.length}}
              <tr><td colspan="3" class="dp-settings__tbl-empty">No labels yet. Add one to get started.</td></tr>
              {{/unless}}
            </tbody>
          </table>
        </div>
      </div><!-- /#dp-settings__labels -->
