      <!-- ══ Organization (current org only) ══ -->
      <div class="dp-settings__panel" id="dp-settings__organizations">
        <div class="dp-settings__panel-header">
          <div>
            <h2 class="dp-settings__panel-title">Organization</h2>
            <p class="dp-settings__panel-desc">Manage the details of this organization.</p>
          </div>
        </div>

        {{#if currentOrg}}
        <div class="dp-settings__form-grid" style="max-width:760px;">
          <div class="dp-settings__form-group">
            <label for="org-display">Name <span class="required">*</span></label>
            <input type="text" id="org-display" class="dp-settings__form-input" value="{{currentOrg.displayName}}" />
          </div>
          <div class="dp-settings__form-group">
            <label for="org-handle">Handle</label>
            <input type="text" id="org-handle" class="dp-settings__form-input dp-settings__form-input--mono" value="{{currentOrg.id}}" readonly />
            <p class="dp-settings__field-hint">Identifier used in URLs. Cannot be changed.</p>
          </div>
          <div class="dp-settings__form-group">
            <label for="org-owner">Business owner</label>
            <input type="text" id="org-owner" class="dp-settings__form-input" value="{{currentOrg.businessOwner}}" />
          </div>
          <div class="dp-settings__form-group">
            <label for="org-owner-contact">Business owner contact</label>
            <input type="text" id="org-owner-contact" class="dp-settings__form-input" value="{{currentOrg.businessOwnerContact}}" />
          </div>
          <div class="dp-settings__form-group">
            <label for="org-owner-email">Business owner email</label>
            <input type="email" id="org-owner-email" class="dp-settings__form-input" value="{{currentOrg.businessOwnerEmail}}" />
          </div>
          <div class="dp-settings__form-group">
            <label for="org-idp-ref">IDP reference ID</label>
            <input type="text" id="org-idp-ref" class="dp-settings__form-input" value="{{currentOrg.idpRefId}}" />
          </div>
          <div class="dp-settings__form-group">
            <label for="org-cp-ref">Control plane reference ID</label>
            <input type="text" id="org-cp-ref" class="dp-settings__form-input" value="{{currentOrg.cpRefId}}" />
          </div>
        </div>
        <div style="margin-top:20px;">
          <button class="dp-settings__btn-primary" id="dp-settings__save-org-btn" type="button" data-handle="{{currentOrg.id}}">
            <i class="bi bi-floppy me-1"></i> Save changes
          </button>
        </div>
        {{else}}
        <p class="dp-settings__tbl-empty">Organization details are unavailable.</p>
        {{/if}}
      </div><!-- /#dp-settings__organizations -->
