      <!-- ══ MCP Servers ══ -->
      <div class="dp-settings__panel" id="dp-settings__mcps">
        <div class="dp-settings__panel-header">
          <div>
            <h2 class="dp-settings__panel-title">MCP Servers</h2>
            <p class="dp-settings__panel-desc">Add, edit, and remove the MCP servers exposed in this developer portal.</p>
          </div>
          <div style="display:flex; gap:10px;">
            <button class="dp-settings__btn-primary" id="dp-settings__add-mcp-btn" type="button">
              <i class="bi bi-plus"></i> Add MCP Server
            </button>
          </div>
        </div>

        <div class="dp-settings__bulk-bar" id="dp-settings__mcps-bulk-bar" style="display:none;" role="region" aria-label="Bulk actions">
          <span class="dp-settings__bulk-bar-count" id="dp-settings__mcps-bulk-bar-count"></span>
          <button type="button" class="dp-settings__btn-danger dp-settings__btn-sm" id="dp-settings__mcps-bulk-delete-btn">
            <i class="bi bi-trash"></i> Delete selected
          </button>
        </div>

        <div class="dp-settings__table-wrap">
          <table class="dp-settings__table">
            <thead>
              <tr>
                <th class="dp-settings__th-check"><input type="checkbox" id="dp-settings__mcps-select-all" aria-label="Select all MCP servers"></th>
                <th>MCP Server</th>
                <th>Version</th>
                <th>Status</th>
                <th style="width:52px;"></th>
              </tr>
            </thead>
            <tbody id="dp-settings__mcps-tbody">
              {{#orgMCPs}}
              <tr id="dp-settings__api-row-{{apiId}}">
                <td class="dp-settings__td-check">
                  <input type="checkbox" class="dp-settings__row-check"
                    data-id="{{apiId}}" data-name="{{apiName}}"
                    aria-label="Select {{apiName}}">
                </td>
                <td>
                  <div class="dp-settings__api-cell">
                    <span class="dp-settings__api-avatar dp-settings__api-avatar--mcp">{{firstTwoLetters apiName}}</span>
                    <div>
                      <div class="dp-settings__cell-name">{{apiName}}</div>
                      <div class="dp-settings__cell-context">/{{apiHandle}}</div>
                    </div>
                  </div>
                </td>
                <td class="dp-settings__cell-version">{{apiVersion}}</td>
                <td>
                  {{#if (eq apiStatus "PUBLISHED")}}
                  <span class="dp-settings__status-badge dp-settings__status-published">
                    <span class="dp-settings__status-dot"></span>Published
                  </span>
                  {{else if (eq apiStatus "DEPRECATED")}}
                  <span class="dp-settings__status-badge dp-settings__status-deprecated">
                    <span class="dp-settings__status-dot"></span>Deprecated
                  </span>
                  {{else}}
                  <span class="dp-settings__status-badge dp-settings__status-draft">
                    <span class="dp-settings__status-dot"></span>Draft
                  </span>
                  {{/if}}
                </td>
                <td class="dp-settings__cell-actions">
                  <button class="dp-settings__action-btn dp-settings__menu-trigger" type="button" aria-label="MCP server actions">
                    <i class="bi bi-three-dots-vertical"></i>
                  </button>
                  <div class="dp-settings__dropdown">
                    <button class="dp-settings__dropdown-item dp-settings__edit-trigger" type="button" data-id="{{apiId}}">
                      <i class="bi bi-pencil"></i> Edit
                    </button>
                    {{#if (eq apiStatus "PUBLISHED")}}
                    <button class="dp-settings__dropdown-item dp-settings__unpublish-trigger" type="button" data-id="{{apiId}}" data-name="{{apiName}}">
                      <i class="bi bi-archive"></i> Deprecate
                    </button>
                    {{else}}
                    <button class="dp-settings__dropdown-item dp-settings__publish-trigger" type="button" data-id="{{apiId}}" data-name="{{apiName}}">
                      <i class="bi bi-cloud-upload"></i> Publish
                    </button>
                    {{/if}}
                    <div class="dp-settings__dropdown-divider"></div>
                    <button class="dp-settings__dropdown-item dp-settings__dropdown-item--danger dp-settings__delete-trigger" type="button"
                      data-id="{{apiId}}" data-name="{{apiName}}">
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </div>
                </td>
              </tr>
              {{/orgMCPs}}
              {{#unless orgMCPs.length}}
              <tr><td colspan="5" class="dp-settings__empty-row">No MCP servers found. Click <strong>Add MCP Server</strong> to get started.</td></tr>
              {{/unless}}
            </tbody>
          </table>
        </div>
      </div><!-- /#dp-settings__mcps -->
