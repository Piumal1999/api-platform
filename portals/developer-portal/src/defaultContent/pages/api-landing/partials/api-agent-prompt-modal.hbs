<div class="modal fade" id="apiAgentPromptModal" tabindex="-1" aria-labelledby="apiAgentPromptModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content dp-hero__modal">

      <div class="dp-hero__modal-header">
        <div class="dp-hero__modal-title-row">
          <span class="dp-hero__modal-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
          <h2 class="dp-hero__modal-title" id="apiAgentPromptModalLabel">Try with AI agent</h2>
        </div>
        <button type="button" class="dp-hero__modal-close" data-bs-dismiss="modal" aria-label="Close">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      </div>

      <div class="dp-hero__modal-info">
        <p class="dp-hero__modal-info-text">Use this prompt to let your AI agent discover and call this API automatically.</p>
        <button type="button" class="dp-hero__run-btn" id="apiBtnRunClaude">
          <i class="bi bi-play-fill" aria-hidden="true"></i> Run in Claude
        </button>
      </div>

      <div class="modal-body dp-hero__modal-body">
        <div class="dp-hero__prompt-card">
          <div class="dp-hero__prompt-actions">
            <button type="button" class="dp-hero__prompt-tool" id="apiBtnDownloadPrompt" title="Download as .txt">
              <i class="bi bi-download"></i>
            </button>
            <button type="button" class="dp-hero__prompt-tool dp-copy__btn" id="apiBtnCopyPrompt" title="Copy prompt">
              <span class="dp-copy__btn-icon"><i class="bi bi-copy"></i></span>
              <span class="dp-copy__btn-check"><i class="bi bi-check"></i> Copied</span>
            </button>
          </div>
          <pre class="dp-hero__prompt-pre" id="apiAgentPromptText">Loading...</pre>
        </div>
      </div>

    </div>
  </div>
</div>
