<div class="dp-page__container">
  <div class="dp-page__header">
    <div>
      <h1 class="dp-page__title">API Workflows</h1>
      <p class="dp-page__desc">Pre-configured workflows let your AI agents reference these best practices to use your APIs correctly, every time — no hallucination, no manual setup.</p>
    </div>
    {{#if apiWorkflows.length}}
      {{#if profile.isAdmin}}
      <a href="{{beforeSeparator baseUrl '/views/'}}/settings#dp-settings__workflows" class="dp-btn dp-btn--primary">
        <i class="bi bi-pencil"></i> Manage workflows
      </a>
      {{/if}}
    {{/if}}
  </div>

  {{#if apiWorkflows.length}}
  <div class="dp-workflow-card__grid">
    {{#each apiWorkflows}}
    {{> workflow-card}}
    {{/each}}
  </div>
  {{else}}
  <div class="dp-empty">
    <span class="dp-empty-icon">
      <i class="bi bi-diagram-3"></i>
    </span>
    <h2 class="dp-empty-title">No workflows yet</h2>
    <p class="dp-empty-desc">Create a workflow to encode a multi-step API sequence your AI agents can follow. Published workflows will appear here for every consumer.</p>
    {{#if profile.isAdmin}}
    <a href="{{beforeSeparator baseUrl '/views/'}}/settings#dp-settings__workflows" class="dp-btn dp-btn--primary dp-btn--lg" style="margin-top:1.5rem;">
      <i class="bi bi-plus"></i> Create workflow
    </a>
    {{/if}}
  </div>
  {{/if}}

  {{> alert}}
</div>
