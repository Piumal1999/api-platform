<!-- ── Hero ───────────────────────────────────────────────── -->
<section class="dp-hero" aria-label="Portal hero">
  <div class="dp-hero__particles" id="dp-hero__particles" aria-hidden="true"></div>

  <div class="dp-hero__dp-hero__body">
    <span class="dp-hero__pill">
      <i class="bi bi-stars" aria-hidden="true"></i>
      Ready for AI agents
    </span>

    <h1 class="dp-hero__headline">
      {{#if (eq devportalMode "MCP_SERVERS_ONLY")}}
      <span class="dp-hero__headline-accent">MCP servers</span><br>built for AI agents.
      {{else if (eq devportalMode "APIS_ONLY")}}
      <span class="dp-hero__headline-accent">APIs &amp; workflows</span><br>built for Developers and AI Agents.
      {{else}}
      <span class="dp-hero__headline-accent">APIs, MCP servers &amp; workflows</span><br>built for Developers and AI Agents.
      {{/if}}
    </h1>

    <p class="dp-hero__desc">
      {{#if (eq devportalMode "MCP_SERVERS_ONLY")}}
      Discover MCP tools and servers, configure them for your AI agents, and get up and running in minutes.
      {{else if (eq devportalMode "APIS_ONLY")}}
      Discover, connect, and orchestrate APIs and workflows. Browse the catalog, subscribe, and get going in minutes.
      {{else}}
      Discover, connect, and orchestrate APIs, MCP tools, and workflows. Browse the catalogs, subscribe, and get going in minutes.
      {{/if}}
    </p>

    <div class="dp-hero__ctas">
      {{#in devportalMode values="DEFAULT,APIS_ONLY"}}
      <a href="{{baseUrl}}/apis" class="dp-hero__btn dp-hero__btn--gradient">
        Browse our APIs <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
      {{/in}}
      {{#in devportalMode values="DEFAULT,MCP_SERVERS_ONLY"}}
      <a href="{{baseUrl}}/mcps" class="dp-hero__btn dp-hero__btn--gradient">
        Browse our MCP servers <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
      {{/in}}
      {{#if showApiWorkflowsNav}}
      <button type="button" class="dp-hero__btn dp-hero__btn--ai" data-bs-toggle="modal" data-bs-target="#discoverAiModal">
        <i class="bi bi-stars" aria-hidden="true"></i> Discover with AI
      </button>
      {{/if}}
    </div>
  </div>
</section>

<!-- ── Discover with AI modal ────────────────────────────── -->
{{#if showApiWorkflowsNav}}
<div class="modal fade" id="discoverAiModal" tabindex="-1" aria-labelledby="discoverAiModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content dp-hero__modal">

      <!-- Modal header -->
      <div class="dp-hero__modal-header">
        <div class="dp-hero__modal-title-row">
          <span class="dp-hero__modal-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
          <h2 class="dp-hero__modal-title" id="discoverAiModalLabel">Discover with AI agents</h2>
        </div>
        <button type="button" class="dp-hero__modal-close" data-bs-dismiss="modal" aria-label="Close">
          <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
      </div>

      <!-- Info bar -->
      <div class="dp-hero__modal-info">
        <p class="dp-hero__modal-info-text">Use this prompt to let your AI agent explore and discover what's available in this portal.</p>
        <button type="button" class="dp-hero__run-btn" id="discoverBtnRunClaude">
          <i class="bi bi-play-fill" aria-hidden="true"></i> Run in Claude
        </button>
      </div>

      <!-- Prompt body -->
      <div class="modal-body dp-hero__modal-body">
        <div class="dp-hero__prompt-card">
          <div class="dp-hero__prompt-actions">
            <button type="button" class="dp-hero__prompt-tool" id="discoverBtnDownloadPrompt" title="Download as .txt">
              <i class="bi bi-download"></i>
            </button>
            <button type="button" class="dp-hero__prompt-tool dp-copy__btn" id="discoverBtnCopyPrompt" title="Copy prompt">
              <span class="dp-copy__btn-icon"><i class="bi bi-copy"></i></span>
              <span class="dp-copy__btn-check"><i class="bi bi-check"></i> Copied</span>
            </button>
          </div>
          <pre class="dp-hero__prompt-pre" id="discoverPromptText"></pre>
        </div>
      </div>

    </div>
  </div>
</div>
{{/if}}

<script src='/technical-scripts/home-particles.js' defer></script>
