<section class="dp-api-listing__section">
  <div class="container-fluid">
    <!-- Hero -->
    <div class="dp-api-listing__hero-container">
      <div class="dp-api-listing__hero-content">
        <h1 class="dp-api-listing__hero-title">Discover, integrate, and innovate with MCP-powered tools for your agents</h1>
        <p class="dp-api-listing__hero-description">Explore our extensive MCP catalog and discover how to integrate them seamlessly into your application.</p>
      </div>
      <div class="dp-api-listing__hero-image">
        <svg width="180" height="150" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 84.8528L85.8822 16.9706C95.2548 7.59798 110.451 7.59798 119.823 16.9706C129.196 26.3431 129.196 41.5391 119.823 50.9117L68.5581 102.177" stroke="#5b7fb9" stroke-width="12" stroke-linecap="round"/>
          <path d="M69.2652 101.47L119.823 50.9117C129.196 41.5391 144.392 41.5391 153.765 50.9117L154.118 51.2652C163.491 60.6378 163.491 75.8338 154.118 85.2063L92.7248 146.6C89.6006 149.724 89.6006 154.789 92.7248 157.913L105.331 170.52" stroke="#5b7fb9" stroke-width="12" stroke-linecap="round"/>
          <path d="M102.853 33.9411L52.6482 84.1457C43.2756 93.5183 43.2756 108.714 52.6482 118.087C62.0208 127.459 77.2167 127.459 86.5893 118.087L136.794 67.8822" stroke="#5b7fb9" stroke-width="12" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="container-fluid dp-api-listing__container">
    <!-- Search -->
    <div class="dp-search__container">
      <div class="dp-search__input">
        <i class="bi bi-search dp-search__icon"></i>
        <input type="text" id="query" placeholder="Search MCP Servers" autocomplete="off" />
      </div>
    </div>

    {{#if (eq apiMetadata.length 0)}}
    <!-- Empty state -->
    <div class="dp-api-listing__empty" id="no-subscription">
      <div class="dp-api-listing__empty-icon">
        <i class="bi bi-info-circle"></i>
      </div>
      <div class="dp-api-listing__empty-body">
        <div class="dp-api-listing__empty-title">No MCP servers available yet</div>
        <p class="dp-api-listing__empty-desc">There are no published MCP servers in this developer portal right now. Once MCP servers are published, they'll appear here for you to explore and subscribe to.</p>
      </div>
    </div>
    {{else}}
    <!-- Results bar -->
    <div class="dp-api-listing__results-bar">
      <h2 class="dp-api-listing__results-heading">MCP Servers <span class="dp-api-listing__results-count">{{apiMetadata.length}}</span></h2>
    </div>
    {{/if}}

    <!-- Grid -->
    <div class="row row-gap-4">
      {{#apiMetadata}}
      <div class="col-lg-4 col-md-6 col-sm-12" id="apiCard-{{id}}">
        <div class="dp-api__card d-flex flex-column{{#if hasSubscription}} dp-api__card--subscribed{{/if}}">

          {{#if hasSubscription}}<div class="dp-api__card-ribbon-wrap"><div class="dp-api__card-ribbon-label">Subscribed</div></div>{{/if}}

          <!-- Top: icon + name + version + type badge -->
          <div class="dp-api__card-top" data-href="{{../baseUrl}}/mcp/{{id}}" style="cursor:pointer;">
            {{#if apiImageMetadata.api-icon}}
            <img src="{{apiImageMetadata.api-icon}}" class="dp-api__card-img" alt="{{or apiTitle name}}" />
            {{else}}
            <span class="dp-api__icon dp-api__icon--mcp">{{firstTwoLetters (or apiTitle name)}}</span>
            {{/if}}
            <div class="dp-api__card-meta">
              <h5 class="dp-api__card-title">{{or apiTitle name}}</h5>
              <div class="dp-api__card-meta-row">
                <span class="dp-api__version">{{version}}</span>
                <span class="dp-badge dp-badge--mcp"><i class="bi bi-cpu"></i> MCP</span>
                <span class="dp-badge dp-badge--ai"><i class="bi bi-robot"></i> AI Ready</span>
                {{#if (eq status "DEPRECATED")}}
                <span class="dp-badge dp-badge--deprecated"><i class="bi bi-exclamation-circle"></i> Deprecated</span>
                {{/if}}
              </div>
            </div>
          </div>

          <!-- Description -->
          <p class="dp-api__card-desc dp-ui__clamp2" data-href="{{../baseUrl}}/mcp/{{id}}" style="cursor:pointer;">{{description}}</p>

          <!-- Tags -->
          <div class="dp-api__card-tags">
            {{#tags}}
            <span class="dp-tag">{{this}}</span>
            {{/tags}}
          </div>

          <!-- Footer -->
          {{#if subscriptionPlans.length}}
          <div class="dp-api__card-footer">
            <div class="dp-api__card-footer-left">
              <a href="{{../baseUrl}}/mcp/{{id}}#subscriptionPlans" class="dp-api__plans-link">
                <i class="bi bi-tag"></i> {{subscriptionPlans.length}} plans
              </a>
            </div>
            {{#if hasSubscription}}
            <a href="{{../baseUrl}}/mcp/{{id}}#subscriptionPlans" class="dp-api__card-view-sub-btn">
              <i class="bi bi-check-circle"></i> View subscription
            </a>
            {{else}}
            <a href="{{../baseUrl}}/mcp/{{id}}#subscriptionPlans"
               class="dp-btn dp-btn--primary {{#if @root.isReadOnlyMode}}disabled{{/if}}"
               {{#if @root.isReadOnlyMode}}aria-disabled="true" tabindex="-1"{{/if}}>Subscribe</a>
            {{/if}}
          </div>
          {{/if}}

          <div class="dp-message__overlay hidden">
            <div class="dp-message__content">
              <i class="bi dp-message__icon"></i>
              <p class="dp-message__text"></p>
            </div>
            <button type="button" class="dp-message__close" aria-label="Close message">&times;</button>
          </div>
        </div>
      </div>
      {{/apiMetadata}}
    </div>
  </div>

  <script src='/technical-scripts/listing-cards.js' defer></script>
</section>
