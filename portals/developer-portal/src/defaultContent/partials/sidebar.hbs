<div class="sidebar" id="sidebar">
  <nav class="nav">
    <a href="{{baseUrl}}/" class="nav-link" id="home">
      <i class="bi bi-house dp-sidebar__icon"></i>
      <span class="dp-sidebar__text">Home</span>
    </a>
    {{#in devportalMode values="DEFAULT,APIS_ONLY"}}
    <a href="{{baseUrl}}/apis" class="nav-link" id="apis">
      <i class="bi bi-boxes dp-sidebar__icon"></i>
      <span class="dp-sidebar__text">APIs</span>
      <i class="bi bi-chevron-right dp-sidebar__chevron dp-sidebar__text"></i>
    </a>
    <div class="submenu dp-api__submenu" id="api-submenu">
      <a href="#" class="nav-link dp-sidebar__submenu-link fw-light" id="api-overview">
        <i class="bi bi-grid dp-sidebar__submenu-icon"></i>
        <span class="dp-sidebar__text">Overview</span>
      </a>
      <a href="#" class="nav-link dp-sidebar__submenu-link fw-light" id="api-docs">
        <i class="bi bi-file-text dp-sidebar__submenu-icon"></i>
        <span class="dp-sidebar__text">Documentation</span>
      </a>
      {{#if showApiKeysNav}}
      <a href="#" class="nav-link dp-sidebar__submenu-link fw-light" id="api-keys-nav">
        <i class="bi bi-key dp-sidebar__submenu-icon"></i>
        <span class="dp-sidebar__text">API Keys</span>
      </a>
      {{/if}}
    </div>
    {{/in}}
    {{#in devportalMode values="DEFAULT,MCP_SERVERS_ONLY"}}
    <a href="{{baseUrl}}/mcps" class="nav-link" id="mcps">
      <img src="/images/mcp-icon.svg" class="dp-sidebar__icon" alt="" />
      <span class="dp-sidebar__text">MCP Servers</span>
      <i class="bi bi-chevron-right dp-sidebar__chevron dp-sidebar__text"></i>
    </a>
    <div class="submenu dp-api__submenu" id="mcp-submenu">
      <a href="#" class="nav-link dp-sidebar__submenu-link fw-light" id="mcp-overview">
        <i class="bi bi-grid dp-sidebar__submenu-icon"></i>
        <span class="dp-sidebar__text">Overview</span>
      </a>
      <a href="#" class="nav-link dp-sidebar__submenu-link fw-light" id="mcp-docs">
        <i class="bi bi-file-text dp-sidebar__submenu-icon"></i>
        <span class="dp-sidebar__text">Documentation</span>
      </a>
    </div>
    {{/in}}
    {{#if showApiWorkflowsNav}}
    <a href="{{baseUrl}}/api-workflows" class="nav-link" id="api-workflows">
      <i class="bi bi-diagram-3 dp-sidebar__icon"></i>
      <span class="dp-sidebar__text">API Workflows</span>
    </a>
    {{/if}}
    <a href="{{baseUrl}}/applications" class="nav-link" id="applications">
      <img src="/images/applications-icon.svg" class="dp-sidebar__icon" alt="" />
      <span class="dp-sidebar__text">Applications</span>
    </a>
    <a href="{{baseUrl}}/subscriptions" class="nav-link" id="subscriptions">
      <i class="bi bi-receipt dp-sidebar__icon"></i>
      <span class="dp-sidebar__text">Subscriptions</span>
    </a>
  </nav>

  {{#if profile.isAdmin}}
  {{!-- Settings is org-scoped (no view segment); derive /:orgName/settings from the view-scoped baseUrl --}}
  <a href="{{beforeSeparator baseUrl '/views/'}}/settings" class="nav-link" id="admin-settings">
    <i class="bi bi-gear dp-sidebar__icon"></i>
    <span class="dp-sidebar__text">Settings</span>
  </a>
  {{/if}}
  <div class="dp-sidebar__section-divider"></div>
  <button class="dp-sidebar__collapse-btn" id="collapseBtn">
    <i class="bi bi-chevron-right"></i>
    <span class="dp-sidebar__collapse-text">Expand</span>
  </button>
</div>
