<header>
  <nav class="navbar navbar-expand-lg dp-header__navbar fixed-top">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center" href="{{baseUrl}}">
        <img src="/images/devportal-logo.svg" alt="Logo" class="dp-header__logo me-2" />
      </a>
      <div class="d-flex align-items-center me-2">
        {{#if profile}}
        <a class="dropdown-toggle dp-profile__link d-flex align-items-center p-1 fw-light" href="#" id="navbarDropdown"
          role="button" data-bs-toggle="dropdown" aria-expanded="false">
          <img src="{{profile.imageURL}}" alt="Profile" class="dp-profile__icon me-2" />
          <span>{{profile.firstName}}</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end dp-profile__options" aria-labelledby="navbarDropdown">
          <li class="dropdown-item">
            <div class="dp-user__profile-info d-flex align-items-center">
              <img src="{{profile.imageURL}}" class="dp-profile__icon me-2" />
              <div>
                <span class="dp-user__name d-block">{{profile.firstName}} {{profile.lastName}}</span>
                <span class="dp-user__email text-muted">{{profile.email}}</span>
              </div>
            </div>
          </li>
          <li>
            <hr class="dropdown-divider" />
          </li>
          <li class="dropdown-item">
            <i class="fas fa-sign-out-alt me-2"></i>
            <a href="{{baseUrl}}/logout" class="dp-profile__dropdown-link">Log Out</a>
          </li>
        </ul>
        {{else}}
        <div id="auth-section">
          <a class="dp-login__btn" href="{{baseUrl}}/login">Log In</a>
        </div>
        {{/if}}
      </div>
    </div>
  </nav>
</header>
